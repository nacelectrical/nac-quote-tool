{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/quote-view", "destination": "/api/quote?nac_fn=quote-view" },
    { "source": "/api/quote-issue", "destination": "/api/quote?nac_fn=quote-issue" },
    { "source": "/api/quote-respond", "destination": "/api/quote?nac_fn=quote-respond" },
    { "source": "/api/presentation-content", "destination": "/api/quote?nac_fn=presentation-content" },
    { "source": "/api/presentation-media", "destination": "/api/quote?nac_fn=presentation-media" },
    { "source": "/api/server-key-selftest", "destination": "/api/selftest?nac_fn=server-key" },
    { "source": "/api/servicem8-selftest", "destination": "/api/selftest?nac_fn=servicem8" }
  ],
  "functions": {
    "api/quote.js": { "includeFiles": "designer/engines/**" },
    "api/selftest.js": { "includeFiles": "designer/engines/**" }
  }
}
