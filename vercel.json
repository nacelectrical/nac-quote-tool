{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/quote-view",
      "destination": "/api/quote?nac_fn=quote-view"
    },
    {
      "source": "/api/quote-issue",
      "destination": "/api/quote?nac_fn=quote-issue"
    },
    {
      "source": "/api/quote-respond",
      "destination": "/api/quote?nac_fn=quote-respond"
    },
    {
      "source": "/api/presentation-content",
      "destination": "/api/quote?nac_fn=presentation-content"
    },
    {
      "source": "/api/presentation-media",
      "destination": "/api/quote?nac_fn=presentation-media"
    },
    {
      "source": "/api/quote-list",
      "destination": "/api/quote?nac_fn=quote-list"
    },
    {
      "source": "/api/servicem8-testjob",
      "destination": "/api/quote?nac_fn=servicem8-testjob"
    },
    {
      "source": "/api/ops",
      "destination": "/api/quote?nac_fn=ops"
    },
    {
      "source": "/api/quote-outreach",
      "destination": "/api/quote?nac_fn=quote-outreach"
    },
    {
      "source": "/api/ops-activity",
      "destination": "/api/quote?nac_fn=ops-activity"
    },
    {
      "source": "/api/server-key-selftest",
      "destination": "/api/selftest?nac_fn=server-key"
    },
    {
      "source": "/api/servicem8-selftest",
      "destination": "/api/selftest?nac_fn=servicem8"
    }
  ],
  "functions": {
    "api/quote.js": {
      "includeFiles": "designer/engines/**"
    },
    "api/selftest.js": {
      "includeFiles": "designer/engines/**"
    }
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).mjs",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/designer/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ]
}
